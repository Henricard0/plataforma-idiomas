# Copie para .env.local e preencha.

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave secreta: só no servidor (usada pelo webhook do Stripe). Nunca exponha no navegador.
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL pública do site (links de confirmação de e-mail e retorno do pagamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- LiveKit: vídeo das aulas e das lives (cloud.livekit.io → Settings → API Keys) ---
NEXT_PUBLIC_LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Stripe: venda dos cursos gravados (dashboard.stripe.com → Developers) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
